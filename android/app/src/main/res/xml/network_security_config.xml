<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base config trusts system CAs and disallows cleartext.
         xsta360.com.ng uses a standard CA certificate. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
