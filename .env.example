# WhatsApp Embedded Signup — enables the "Connect with Facebook" button in
# Settings so client orgs can link their WhatsApp Business account in one click.
# NEXT_PUBLIC_META_APP_ID: your Meta app ID (developers.facebook.com/apps)
# NEXT_PUBLIC_META_CONFIG_ID: Facebook Login for Business configuration ID
#   (Meta app → WhatsApp → Configuration, or Facebook Login for Business → Configurations)
# META_APP_SECRET: your Meta app secret (server-only — used to exchange auth codes)
# NEXT_PUBLIC_* vars are baked into the client bundle at build time.
NEXT_PUBLIC_META_APP_ID=""
NEXT_PUBLIC_META_CONFIG_ID=""
META_APP_SECRET=""
