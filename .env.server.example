# Server environment — copy to .env on the server and fill in
# Generate SESSION_SECRET with: openssl rand -hex 32
SESSION_SECRET=replace-with-openssl-rand-hex-32
POSTGRES_PASSWORD=change-this-to-a-strong-password
APP_URL=http://67.211.210.8
EMAIL_FROM=Xsta360 <noreply@xsta360.app>
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
CRON_SECRET=change-this-to-a-random-string

# WhatsApp Embedded Signup — enables the "Connect with Facebook" button so
# client orgs link their WhatsApp Business account without a Meta developer
# account. Meta app dashboard → App ID / App secret; config ID from
# Facebook Login for Business → Configurations.
# NEXT_PUBLIC_* vars are baked into the bundle at `docker compose build` —
# set them BEFORE building the app image.
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
META_APP_SECRET=
# Webhook verify token — any random string; paste the same value into
# Meta app → WhatsApp → Configuration → Webhooks → Verify token.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
